# VPS bot config — edit before install
TIMEFRAME=30m
CAPITAL=20000
RISK=0.0075
POLL=180

# Valfritt: Telegram-notiser vid RÖD hälsoflagg (strategi degraderad).
# Skapa bot via @BotFather, hämta chat-id via @userinfobot. Lämna tomt för
# att bara logga larm till data/live/health_alerts.log.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Alpaca-mäklare (aktier/ETF/crypto). Skapa gratis konto på alpaca.markets.
# Börja ALLTID med paper (riktig ordermekanik, inga riktiga pengar).
# ALPACA_ENV=live = RIKTIGA PENGAR — sätt bara när du medvetet vill gå live.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_ENV=paper
